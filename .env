# SQLite database (file-based, zero-config for local dev)
DATABASE_URL="file:./dev.db"

# Secret used to sign session JWTs. Replace with a strong value in production,
# e.g. `openssl rand -base64 32`.
AUTH_SECRET="dev-secret-change-me-in-production-0f8a1c2b3d4e5f6a"

# Email — used by the "forgot password" flow. If SMTP_HOST is left unset,
# reset emails are printed to the server console instead of being sent, so the
# flow is fully testable locally with zero setup. Fill these in to send real
# mail in production.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_SECURE="false"                    # "true" for implicit TLS (port 465)
# MAIL_FROM="Muse <no-reply@modelhub.test>"

# Base URL used to build links in emails (e.g. password-reset). REQUIRED in
# production — email links never trust the request Host header. In development
# it defaults to http://localhost:3000 if unset.
APP_URL="http://localhost:3000"
