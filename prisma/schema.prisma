generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER_ADMIN
  MODERATOR
}

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED_FRAUD
  SUSPENDED
}

enum ModelStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Gender {
  FEMALE
  MALE
  NONBINARY
}

/// Public site accounts: browse, submit talent and leave reviews.
/// Admin access lives in a separate `Admin` table (see below).
model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  status       UserStatus @default(PENDING) // only ACTIVE members may sign in
  avatarUrl    String?
  createdAt    DateTime   @default(now())

  models       Model[]    @relation("SubmittedModels")
  reviews      Review[]

  @@index([status])
}

/// Agency staff who sign in to the admin console. Fully separate from `User`:
/// distinct credentials, distinct login (`/admin/login`) and distinct session
/// cookie, so a public account can never gain admin access.
model Admin {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(MODERATOR)
  avatarUrl    String?
  createdAt    DateTime  @default(now())

  reviewedModels Model[] @relation("ReviewedBy")
}

model Model {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  headshotUrl String?
  bio         String
  category    String
  gender      Gender      @default(FEMALE)
  location    String
  experience  String      @default("New Face") // New Face, Developing, Established, Pro
  status      ModelStatus @default(PENDING)
  featured    Boolean     @default(false)

  // Physical stats
  heightCm    Int
  bust        Int? // cm
  waist       Int? // cm
  hips        Int? // cm
  shoeEu      Float?
  hairColor   String?
  eyeColor    String?

  // Contact / links
  instagram   String?
  agencyEmail String?

  // Portfolio gallery (JSON-encoded array of image URLs)
  gallery     String      @default("[]")

  // Denormalised rating cache (kept in sync when reviews change)
  ratingAvg   Float       @default(0)
  ratingCount Int         @default(0)

  // Approval workflow metadata
  reviewNote  String?
  reviewedAt  DateTime?
  reviewedById String?
  reviewedBy   Admin?     @relation("ReviewedBy", fields: [reviewedById], references: [id])

  submittedById String?
  submittedBy   User?     @relation("SubmittedModels", fields: [submittedById], references: [id])

  reviews     Review[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status])
  @@index([category])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int // 1..5
  title     String?
  body      String
  createdAt DateTime @default(now())

  modelId   String
  model     Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)

  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([modelId, authorId]) // one review per user per model
  @@index([modelId])
}
