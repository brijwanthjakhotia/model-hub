# Copy to `.env` and fill in. (This demo commits a working `.env` for zero-config
# local dev; a real deployment should NOT commit secrets — see README.)

# SQLite database (file-based, zero-config for local dev)
DATABASE_URL="file:./dev.db"

# Secret used to sign session JWTs. Generate a strong value:
#   openssl rand -base64 32
AUTH_SECRET="change-me"

# Email — used by the "forgot password" flow. If SMTP_HOST is left unset, reset
# emails are printed to the server console instead of being sent (handy for
# local dev). Fill these in to send real mail.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_SECURE="false"                    # "true" for implicit TLS (port 465)
# MAIL_FROM="Muse <no-reply@modelhub.test>"

# Base URL for links embedded in emails. REQUIRED in production (email links
# never trust the request Host header). Defaults to http://localhost:3000 in dev.
APP_URL="http://localhost:3000"

# Number of trusted reverse-proxy hops in front of the app. Enables per-IP rate
# limiting by reading the correct X-Forwarded-For entry. Leave 0/unset if the app
# is not behind a trusted proxy.
# TRUSTED_PROXY_HOPS="1"
